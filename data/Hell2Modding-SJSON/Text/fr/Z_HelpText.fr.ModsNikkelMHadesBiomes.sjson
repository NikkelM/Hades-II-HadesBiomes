    {
      Id = "ModsNikkelMHadesBiomes_UnlockPostBossSellShopsIncantation_Flavor"
      Description =
      "Le Titan Chronos et le nocher Charon s'accordent sur bien peu de choses, mais tous deux savent que presque tout peut s'acheter au bon prix, même les faveurs des Olympiens."
    }
    // Add Pool of Purging/SellShops/SellTraitShops to any rooms during a run
    {
      Id = "ModsNikkelMHadesBiomes_UnlockInRunSellShopsIncantation"
      DisplayName = "Éveil des Fontaines Rouge Sang"
