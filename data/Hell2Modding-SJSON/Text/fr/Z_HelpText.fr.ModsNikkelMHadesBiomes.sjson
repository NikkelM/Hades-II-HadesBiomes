    }
    {
      Id = "ModsNikkelMHadesBiomes_UnlockPostBossGiftRackIncantation_Flavor"
      Description =
      "Pour la Princesse des Cauchemars, aucun rêve n'est assez éloigné de la réalité pour l'empêcher de se souvenir de ceux qui lui sont chers."
    }
    // Add Reprieve/Fountain Chambers
    {
      Id = "ModsNikkelMHadesBiomes_UnlockTartarusReprieveIncantation"
      DisplayName = "Source de Vie Sinistre"
      Description =
      "Révèle une chambre secrète dans le {$Keywords.ModsNikkelMHadesBiomesLocation_Hades_Tartarus_Short} du {$Keywords.ModsNikkelMHadesBiomesModdedRoute}, où vous pourrez restaurer un peu de {!Icons.HealthRestoreHome} et échapper à vos ennemis."
    }
    {
      Id = "ModsNikkelMHadesBiomes_UnlockTartarusReprieveIncantation_Flavor"
      Description =
      "Dissimulés dans un recoin oublié du Tartare se trouvent des bains abandonnés, où les Érinyes venaient jadis se reposer de leur devoir éternel."
    }
    {
      Id = "ModsNikkelMHadesBiomes_UnlockAsphodelReprieveIncantation"
      DisplayName = "Source de Vie Brûlante"
      Description =
      "Révèle une chambre secrète dans l'{$Keywords.ModsNikkelMHadesBiomesLocation_Hades_Asphodel_Short} du {$Keywords.ModsNikkelMHadesBiomesModdedRoute}, où vous pourrez restaurer un peu de {!Icons.HealthRestoreHome} et échapper à vos ennemis."
    }
    {
      Id = "ModsNikkelMHadesBiomes_UnlockAsphodelReprieveIncantation_Flavor"
      Description =
      "Comment cette fontaine oubliée ne s'est pas encore évaporée dans la chaleur de l'Asphodèle est un mystère qu'il vaut mieux ne pas creuser, de peur d'obtenir des réponses que l'on ne souhaite pas connaître."
    }
    {
      Id = "ModsNikkelMHadesBiomes_UnlockElysiumReprieveIncantation"
      DisplayName = "Source de Vie Brumeuse"
      Description =
      "Révèle une chambre secrète dans l'{$Keywords.ModsNikkelMHadesBiomesLocation_Hades_Elysium_Short} du {$Keywords.ModsNikkelMHadesBiomesModdedRoute}, où vous pourrez restaurer un peu de {!Icons.HealthRestoreHome} et échapper à vos ennemis."
    }
    {
      Id = "ModsNikkelMHadesBiomes_UnlockElysiumReprieveIncantation_Flavor"
      Description =
      "Même les plus grands héros passés dans l'Élysée n'ont pas le droit de boire l'eau jaillissant de ses fontaines, réservée aux seuls dieux."
    }
    // Add Infernal Troves/Moon Monuments
    {
