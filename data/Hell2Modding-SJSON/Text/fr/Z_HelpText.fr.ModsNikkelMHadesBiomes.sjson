    // #region Fish
    // #region Tartarus
    // -- Taken from the Hades HelpText Fish_Tartarus_Common_01
    {
      _Short variants are limited to 10 characters
      Id = "Fish_Tartarus_Common_01_Short"
      DisplayName = "Mollus"
    }
    {
      Id = "Fish_Tartarus_Common_01"
      DisplayName = "Mollus"
      Description = "Créature commune du Styx."
    }
    {
      Id = "Fish_Tartarus_Common_01_Details"
      Description =
      "· Trouvé avec la {!Icons.ToolRodIcon} {$WeaponShopItemData.ToolFishingRod.Name} aux {$Keywords.FishingPointPlural} dans le {#BoldFormat}Tartare (Cauchemar){#Prev}"
    }
    // -- Adapted from the Hades CodexText CodexData_FishTartarusCommon01_01
    // -- Character limit for descriptions is ~210
    {
      Id = "Fish_Tartarus_Common_01_Flavor"
      DisplayName = ""
      Description =
      "À en juger par leur apparence, ils étaient autrefois des passagers clandestins accrochés à la coque du bateau de Charon, voyageant le long du Styx de la surface jusqu'aux profondeurs des Enfers."
    }
    {
      Id = "Fish_Tartarus_Rare_01_Short"
      DisplayName = "Rascos"
    }
    {
      Id = "Fish_Tartarus_Rare_01"
      DisplayName = "Rascos"
      Description = "Créature peu commune du Styx."
    }
    {
      Id = "Fish_Tartarus_Rare_01_Details"
      Description =
      "· Trouvé avec la {!Icons.ToolRodIcon} {$WeaponShopItemData.ToolFishingRod.Name} aux {$Keywords.FishingPointPlural} dans le {#BoldFormat}Tartare (Cauchemar){#Prev}"
    }
    {
      Id = "Fish_Tartarus_Rare_01_Flavor"
      DisplayName = ""
      Description =
      "Il semblerait qu'ils aient autrefois été de véritables créatures aquatiques, dont les esprits vacillants ont été emportés par les flots du Styx pour entamer ici une forme de non-vie."
    }
    {
      Id = "Fish_Tartarus_Legendary_01_Short"
      DisplayName = "Scyllang."
    }
    {
      Id = "Fish_Tartarus_Legendary_01"
      DisplayName = "Scyllanguille"
      Description = "Créature insaisissable du Styx."
    }
    {
      Id = "Fish_Tartarus_Legendary_01_Details"
      Description =
      "· Trouvé occasionnellement avec la {!Icons.ToolRodIcon} {$WeaponShopItemData.ToolFishingRod.Name} aux {$Keywords.FishingPointPlural} dans le {#BoldFormat}Tartare (Cauchemar){#Prev}"
    }
    {
      Id = "Fish_Tartarus_Legendary_01_Flavor"
      DisplayName = ""
      Description =
      "Savoir si ces créatures sont apparentées à Scylla ou si elles ne font qu'y ressembler reste sujet à débat, sachant que personne n'a encore pris la peine de poser la question à Scylla elle-même."
    }
    // #endregion
    // #region Asphodel
    // -- Taken from the Hades HelpText Fish_Asphodel_Common_01
    {
      Id = "Fish_Asphodel_Common_01_Short"
      DisplayName = "Magmace"
    }
    {
      Id = "Fish_Asphodel_Common_01"
      DisplayName = "Magmace"
      Description = "Créature commune du Phlégéthon."
    }
    {
      Id = "Fish_Asphodel_Common_01_Details"
      Description =
      "· Trouvée avec la {!Icons.ToolRodIcon} {$WeaponShopItemData.ToolFishingRod.Name} aux {$Keywords.FishingPointPlural} dans l'{#BoldFormat}Asphodèle (Cauchemar){#Prev}"
    }
    // -- Adapted from the Hades CodexText CodexData_FishAsphodelCommon01_01
    {
      Id = "Fish_Asphodel_Common_01_Flavor"
      DisplayName = ""
      Description =
      "Elle est quasi impossible à repérer à l'œil nu, se dissimulant dans le magma en constante ébullition, se nourrissant de fragments de minéraux en fusion, et qui sait de quoi d'autre encore."
    }
    {
      Id = "Fish_Asphodel_Rare_01_Short"
      DisplayName = "Chrustison"
    }
    {
      Id = "Fish_Asphodel_Rare_01"
      DisplayName = "Chrustison"
      Description = "Créature peu commune du Phlégéthon."
    }
    {
      Id = "Fish_Asphodel_Rare_01_Details"
      Description =
      "· Trouvé avec la {!Icons.ToolRodIcon} {$WeaponShopItemData.ToolFishingRod.Name} aux {$Keywords.FishingPointPlural} dans l'{#BoldFormat}Asphodèle (Cauchemar){#Prev}"
    }
    {
      Id = "Fish_Asphodel_Rare_01_Flavor"
      DisplayName = ""
      Description =
      "Dans les eaux océaniques, des créatures similaires sont des proies faciles ; mais pas cette variété friande de magma, généralement laissée en paix. Certaines remontent du lit du fleuve en quête de compagnie."
    }
    {
      Id = "Fish_Asphodel_Legendary_01_Short"
      DisplayName = "Mangefl."
    }
    {
      Id = "Fish_Asphodel_Legendary_01"
      DisplayName = "Mangeflamme"
      Description = "Créature insaisissable du Phlégéthon."
    }
    {
      Id = "Fish_Asphodel_Legendary_01_Details"
      Description =
      "· Trouvé occasionnellement avec la {!Icons.ToolRodIcon} {$WeaponShopItemData.ToolFishingRod.Name} aux {$Keywords.FishingPointPlural} dans l'{#BoldFormat}Asphodèle (Cauchemar){#Prev}"
    }
    {
      Id = "Fish_Asphodel_Legendary_01_Flavor"
      DisplayName = ""
      Description =
      "Ses tentacules sinueux et son corps écailleux rappellent le serpent Ladon, mais nul ne sait encore si c'est lui ou un autre monstre qui a donné naissance à une telle créature."
    }
    // #endregion
    // #region Elysium
    // -- Taken from the Hades HelpText Fish_Elysium_Common_01
    {
      Id = "Fish_Elysium_Common_01_Short"
      DisplayName = "Chalourde"
    }
    {
      Id = "Fish_Elysium_Common_01"
      DisplayName = "Chalourde"
      Description = "Créature commune du Léthé."
    }
    {
      Id = "Fish_Elysium_Common_01_Details"
      Description =
      "· Trouvée avec la {!Icons.ToolRodIcon} {$WeaponShopItemData.ToolFishingRod.Name} aux {$Keywords.FishingPointPlural} dans l'{#BoldFormat}Élysée (Cauchemar){#Prev}"
    }
    // -- Adapted from the Hades CodexText CodexData_FishElysiumCommon01_01
    {
      Id = "Fish_Elysium_Common_01_Flavor"
      DisplayName = ""
      Description =
      "La Chalourde commune abonde dans les eaux brumeuses du Léthé, qui s'écoulent le long des collines et des vallées de l'Élysée. Sa coquille est le plus souvent close si fermement qu'on ne peut l'ouvrir."
    }
    {
      Id = "Fish_Elysium_Rare_01_Short"
      DisplayName = "Charpe"
    }
    {
      Id = "Fish_Elysium_Rare_01"
      DisplayName = "Charpe"
      Description = "Créature peu commune du Léthé."
    }
    {
      Id = "Fish_Elysium_Rare_01_Details"
      Description =
      "· Trouvée avec la {!Icons.ToolRodIcon} {$WeaponShopItemData.ToolFishingRod.Name} aux {$Keywords.FishingPointPlural} dans l'{#BoldFormat}Élysée (Cauchemar){#Prev}"
    }
    {
      Id = "Fish_Elysium_Rare_01_Flavor"
      DisplayName = ""
      Description =
      "La Charpe Élysienne semble être l'ombre d'un poisson de la surface qui lui ressemble beaucoup, avec ses écailles multicolores et son tempérament placide, voire presque contemplatif."
    }
    {
      Id = "Fish_Elysium_Legendary_01_Short"
      DisplayName = "Hippomer"
    }
    {
      Id = "Fish_Elysium_Legendary_01"
      DisplayName = "Hippomer"
      Description = "Créature insaisissable du Léthé."
    }
    {
      Id = "Fish_Elysium_Legendary_01_Details"
      Description =
      "· Trouvé occasionnellement avec la {!Icons.ToolRodIcon} {$WeaponShopItemData.ToolFishingRod.Name} aux {$Keywords.FishingPointPlural} dans l'{#BoldFormat}Élysée (Cauchemar){#Prev}"
    }
    {
      Id = "Fish_Elysium_Legendary_01_Flavor"
      DisplayName = ""
      Description =
      "Dans l'Élysée, nombreux sont les anciens héros que l'on surprend à fixer les eaux du Léthé, espérant apercevoir ne serait-ce qu'un bref instant l'une de ces créatures majestueuses."
    }
