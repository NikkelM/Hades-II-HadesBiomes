    }
    {
      Id = "ModsNikkelMHadesBiomesUnlockCosmeticsIncantation_Flavor"
      Description =
      "La Princesse des Enfers et son frère Zagreus partagent un même goût pour la décoration de leurs demeures respectives, au grand dam de leurs gardiens."
    }
    // Add ShrineChallenges/Erebus Gates to modded runs
    {
      Id = "ModsNikkelMHadesBiomes_UnlockShrinePointGatesIncantation"
      DisplayName = "Déliement des Portails Infernaux"
