    }
    {
      Id = "ModsNikkelMHadesBiomes_OrpheusEurydiceQuestItem_Flavor"
      Description =
      "Parmi les monceaux de paperasse administrative de la Maison d'Hadès gisait autrefois un vieux document concernant un pacte spécial signé par un musicien de la cour jadis vivant, qui tenta vainement d'arracher son épouse à la mort."
    }
    // Release Sisyphus
    {
      Id = "ModsNikkelMHadesBiomes_SisyphusQuestItem"
      DisplayName = "Sentence du Roi Déchu"
      Description =
      "Libère {$Keywords.CharSisyphus} d'une éternité de dur labeur."
    }
    {
      Id = "ModsNikkelMHadesBiomes_SisyphusQuestItem_Flavor"
      Description =
      "Parmi les archives des morts et des condamnés de la Maison d'Hadès gisaient autrefois les documents scellés connus sous le nom de Sentence du Roi Déchu, condamnant ledit roi à pousser un rocher sans fin jusqu'à la fin des temps."
    }
