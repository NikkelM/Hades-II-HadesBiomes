    }
    {
      Id = "ModsNikkelMHadesBiomes_UnlockShrinePointGatesIncantation_Flavor"
      Description =
      "L'Érèbe est bien plus que les bois entourant la Croisée. Votre père, le seigneur Hadès, s'en servait autrefois pour contenir l'armée sans cesse grandissante des ombres attendant son jugement."
    }
    // Add Pool of Purging/SellShops/SellTraitShops to post-boss rooms
    {
      Id = "ModsNikkelMHadesBiomes_UnlockPostBossSellShopsIncantation"
      DisplayName = "Jaillissement des Fontaines Rouge Sang"
