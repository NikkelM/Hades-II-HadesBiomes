    {
      Id = "ModsNikkelMHadesBiomes_BreakableValue2Incantation_Flavor"
      Description =
      "Chaque âme voyageant vers les Enfers est censée apporter de quoi payer son passage — certaines en apportèrent plus que nécessaire et abandonnèrent le surplus en chemin."
    }
    {
      Id = "ModsNikkelMHadesBiomes_BreakableValue3Incantation"
      DisplayName = "Urnes de Fortune, Majeures"
      Description =
      "Les {#BoldFormatGraftDark}Urnes Dorées {#Prev} du {$Keywords.ModsNikkelMHadesBiomesModdedRoute} rapportent désormais jusqu'à {#UpgradeFormatDark}+{$EnemyData.Breakable.BreakableValueOptions[1].MoneyDropOnDeath.MaxValue}{#Prev}{!Icons.Currency} une fois brisées."
    }
    {
      Id = "ModsNikkelMHadesBiomes_BreakableValue3Incantation_Flavor"
      Description =
      "Le nocher Charon possède bien des sources de revenus et se retrouve souvent avec plus de pièces qu'il ne peut en porter, sachant que tout surplus abandonné finira de toute façon par lui revenir."
    }
    // Unlock/Free Orpheus
    {
      Id = "ModsNikkelMHadesBiomes_OrpheusUnlockItem"
      DisplayName = "Sentence du Musicien de la Cour"
