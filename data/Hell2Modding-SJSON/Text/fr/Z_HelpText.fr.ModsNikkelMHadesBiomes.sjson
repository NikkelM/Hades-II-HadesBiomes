      "Fait que les {$Keywords.RoomPlural} du {$Keywords.ModsNikkelMHadesBiomesModdedRoute} abritent parfois un {$Keywords.WellShop}."
    }
    {
      Id = "ModsNikkelMHadesBiomes_UnlockInRunWellShopsIncantation_Flavor"
      Description =
      "Le nocher Charon fut d'une grande aide au Prince Zagreus lors de ses tentatives d'évasion des Enfers, toujours prêt à lui prêter main-forte — au bon prix."
