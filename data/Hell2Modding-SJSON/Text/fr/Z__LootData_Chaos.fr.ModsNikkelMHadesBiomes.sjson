{
  lang = "fr"
  Texts = [
    // #region Intro conversations/New route explanation
    {
      Id = "Modsnikkelmhadesbiomescustomchaos_0000"
      InheritFrom = "BaseNarrative"
      DisplayName =
      "Bienvenue, Rejetonne d'Hadès, en ce lieu que tu nommes le Tartare. J'en conclus que tu as franchi le portail que j'ai ouvert pour toi en ce lieu entre les royaumes, où résident les Invisibles ? Réponds."
      }
    {
      Id = "Modsnikkelmhadesbiomescustommelinoe_0000"
      InheritFrom = "BaseNarrative"
      DisplayName =
      "Chaos Tout-Puissant, j'ai en effet traversé le portail que vous avez ouvert au sein de la Croisée. Comment est-il possible que je me trouve ici ? Ce Tartare me semble familier, mais... différent."
      }
    {
      Id = "Modsnikkelmhadesbiomescustomchaos_0001"
      InheritFrom = "BaseNarrative"
      DisplayName =
      "J'ai altéré ta perception de la réalité pour cette nuit, aidé en cela par ta propre faculté à percer le voile des rêves et du temps. Le voyage de ton frère devient le tien. Accepte mon empreinte, et retrouve-moi."
      }
    {
      Id = "Modsnikkelmhadesbiomescustomchaos_0002"
      InheritFrom = "BaseNarrative"
      DisplayName =
      "Le lieu dans lequel tu te trouves cette nuit suscite en toi un certain malaise, n'est-ce pas ? Réponds."
      }
    {
      Id = "Modsnikkelmhadesbiomescustommelinoe_0001"
      InheritFrom = "BaseNarrative"
      DisplayName =
      "En effet, Chaos Tout-Puissant. Vous avez dit tout à l'heure m'avoir engagée sur le chemin de mon frère, mais j'ignore ce que je cherche dans cette version altérée du Tartare."
      }
    {
      Id = "Modsnikkelmhadesbiomescustomchaos_0003"
      InheritFrom = "BaseNarrative"
      DisplayName =
      "Ton frère a jadis cherché à s'échapper de la demeure de ton père. Je t'ai engagée sur ce même chemin au sein de ce {$Keywords.ModsNikkelMHadesBiomesModdedRoute}. En temps voulu, tu parviendras à comprendre plus profondément les motivations de ton frère."
      }
    {
      Id = "Modsnikkelmhadesbiomescustommelinoe_0002"
      InheritFrom = "BaseNarrative"
      DisplayName =
      "En effet, Chaos Tout-Puissant. Une autre nuit, j'ai rencontré l'Érinye Mégère, et je me suis remémoré l'une des rencontres de mon frère avec elle. S'agissait-il de {#Emph}souvenirs{#Prev}, ou d'imagination ?"
      }
    {
      Id = "Modsnikkelmhadesbiomescustomchaos_0004"
      InheritFrom = "BaseNarrative"
      DisplayName =
      "Ton frère a jadis cherché à s'échapper de la demeure de ton père. Je t'ai engagée sur ce même chemin au sein de ce {$Keywords.ModsNikkelMHadesBiomesModdedRoute}. Tout ce dont tu te souviens a eu lieu, dans cette réalité ou dans une autre."
      }
    {
      Id = "Modsnikkelmhadesbiomescustomchaos_0005"
      InheritFrom = "BaseNarrative"
      DisplayName =
      "Depuis notre dernière rencontre, tu en as appris davantage sur ce qui te lie à ton frère en ce royaume, n'est-ce pas ? Réponds."
      }
    {
      Id = "Modsnikkelmhadesbiomescustommelinoe_0003"
      InheritFrom = "BaseNarrative"
      DisplayName =
      "Une autre nuit, j'ai rencontré l'Érinye Mégère, et je me suis remémoré l'une des rencontres de mon frère avec elle. S'agissait-il de {#Emph}souvenirs{#Prev}, ou d'imagination ?"
      }
    {
      Id = "Modsnikkelmhadesbiomescustomchaos_0006"
      InheritFrom = "BaseNarrative"
      DisplayName =
      "Tout ce dont tu te souviens a eu lieu, dans cette réalité ou dans une autre. Continue de chercher à comprendre le chemin de ton frère, tandis que j'observerai tes progrès."
      }
    // #endregion
    // #region Misc dialogues
    {
      Id = "Modsnikkelmhadesbiomescustomchaos_0007"
      InheritFrom = "BaseNarrative"
      DisplayName =
      "J'ai déduit de nos précédentes rencontres que tu portes de l'intérêt à l'histoire de ton frère. J'ai conclu qu'il serait fort amusant de te laisser emprunter le chemin qu'il a pris lorsqu'il tenta jadis d'en apprendre plus sur votre passé commun. Cette conclusion s'est révélée juste."
      }
    {
      Id = "Modsnikkelmhadesbiomescustomchaos_0008"
      InheritFrom = "BaseNarrative"
      DisplayName =
      "Je me souviens des nombreuses fois où ton frère est entré dans mon royaume au cours de sa quête ; de la même façon que beaucoup de ses tentatives se ressemblaient entre elles, les tiennes se comparent aux siennes. Pourtant, jamais deux ne seront identiques, car chacune est unique à sa manière. Je médite souvent sur les implications de cela."
      }
    {
      Id = "Modsnikkelmhadesbiomescustomchaos_0009"
      InheritFrom = "BaseNarrative"
      DisplayName =
      "Tu auras depuis remarqué que, bien que tu sembles revivre les souvenirs de ton frère, tous les aspects de ce {$Keywords.ModsNikkelMHadesBiomesModdedRoute} ne concordent pas avec ce qu'il a vécu. Une part de toi demeure liée à ta propre réalité, tout comme ton lien avec l'Olympe."
      }
    // #endregion
    // #region Randomized Chaos Trials/Questline
    {
      Id = "Modsnikkelmhadesbiomescustomchaos_0010"
      InheritFrom = "BaseNarrative"
      DisplayName =
      "Rejetonne d'Hadès, une fois encore tu es entrée dans le royaume des possibilités quasi infinies, révélant ainsi une nouvelle facette de la réalité. Te libérer des limites habituelles de tes Cauchemars donnera les résultats les plus intéressants. Poursuis, je te prie."
      }
    {
      Id = "Modsnikkelmhadesbiomescustomchaos_0011"
      InheritFrom = "BaseNarrative"
      DisplayName =
      "Tes propres facultés te permettent d'altérer les événements que tu perçois comme les souvenirs du passé de ton frère. Contempler ces réalités altérées à travers la Pierre Noire m'accorde en outre la capacité d'explorer des possibilités plus éloignées encore de ce qui fut."
      }
    // #endregion
  ]
}
