{
  lang = "fr"
  Texts = [
    #region First conversation immediately after a modded run
    {
      Id = "Modsnikkelmhadesbiomescustomodysseus_0000"
      InheritFrom = "BaseNarrative"
      DisplayName =
      "J'ai un un rapport des plus particuliers, Déesse. Nos guetteurs au Camp d'Entraînement rapportent qu'un portail de Chaos se serait ouvert, que vous l'auriez franchi hier, avant de réapparaitre dans votre tente au matin. Voulez-vous bien vous expliquer ?"
    }
    {
      Id = "Modsnikkelmhadesbiomescustommelinoe_0004"
      InheritFrom = "BaseNarrative"
      DisplayName =
      "Je ne sais pas si je {#Emph}peux {#Prev}expliquer ce qu'il s'est passé, Ulysse. D'ordinaire, ces portails me permettent de rendre visite à Chaos dans son domaine. Mais la nuit dernière, il m'a semblé revivre les souvenirs de mon frère, dans le cadre de l'une des expériences de Chaos."
    }
    {
      Id = "Modsnikkelmhadesbiomescustomodysseus_0001"
      InheritFrom = "BaseNarrative"
      DisplayName =
      "{#Emph}Ça{#Prev}, c'est le début d'un récit qui mérite d'être entendu, si vous voulez mon avis. Tenez-moi au courant de ce que vous découvrirez, Déesse... Je suis certain que nous saurons tirer bénéfice d'un tel savoir."
    }
    #endregion
  ]
}
