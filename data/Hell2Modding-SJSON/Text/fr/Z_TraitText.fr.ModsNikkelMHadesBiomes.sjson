      DisplayName = "Cœur de Pierre"
      Description = "Vous croyez en Pierrot, et Pierrot croit en vous. \n{!Icons.Bullet}{#PropertyFormat}Vitesse de Déplacement : {#Prev}{#UpgradeFormat}{$TooltipData.ExtractData.TooltipSpeed:P}{#Prev}"
