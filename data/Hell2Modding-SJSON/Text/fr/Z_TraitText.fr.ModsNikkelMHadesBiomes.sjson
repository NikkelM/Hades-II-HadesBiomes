    // #region Charon
    {
      Id = "DiscountTrait"
      DisplayName = "Client Fidèle"
      Description = "Toutes les marchandises de Charon coûtent {#UpgradeFormat}-{$TooltipData.ExtractData.TooltipDiscount}% {!Icons.Currency} {#Prev} moins cher {#ItalicFormat}(pour cette tentative d'évasion){#Prev}."
    }
    // #endregion
    // #region Orpheus
    {
      Id = "ModsNikkelMHadesBiomesOrpheusChaosThemeBoon"
      InheritFrom = "MusicMusicPlayerChaosThemeMusicPlayer"
      Description =
      "Garantit l'apparition d'une {$Keywords.HealthGate} le plus tôt possible. {#Emph}Toutes {#Prev}les {$Keywords.HealthGatePlural} coûtent {#UpgradeFormat}0{#Prev}{!Icons.Health} cette nuit."
    }
    {
      Id = "ModsNikkelMHadesBiomesOrpheusChaosThemeBoonChaosGatesStatDisplay"
