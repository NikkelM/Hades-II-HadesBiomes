      InheritFrom = "MusicMusicPlayerBossFightMusicMusicPlayer"
      Description =
      "La plupart des ennemis que vous tuez peuvent revenir combattre à vos côtés, une fois par {$Keywords.EncounterAlt} au maximum."
    }
    {
      Id = "ModsNikkelMHadesBiomesOrpheusBossFightMusicBoonResurrectStatDisplay"
