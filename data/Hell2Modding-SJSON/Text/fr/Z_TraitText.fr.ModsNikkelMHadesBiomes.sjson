      Description = "Vous croyez en Pierrot, et Pierrot croit en vous. \n{!Icons.Bullet}{#PropertyFormat} Dégâts de [Technique]{$Keywords.SpecialSet} : {#Prev}{#UpgradeFormat}{$TooltipData.ExtractData.TooltipDamage:P}{#Prev}"
    }
    {
