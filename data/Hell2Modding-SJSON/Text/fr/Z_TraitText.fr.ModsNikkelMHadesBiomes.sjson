      DisplayName = "Cœur de Pierre"
      Description = "Vous croyez en Pierrot, et Pierrot croit en vous. \n{!Icons.Bullet}{#PropertyFormat}Dégâts de [Lancer]{$Keywords.CastSet} : {#Prev}{#UpgradeFormat}{$TooltipData.ExtractData.TooltipDamage:P}{#Prev}"
    }
    {
