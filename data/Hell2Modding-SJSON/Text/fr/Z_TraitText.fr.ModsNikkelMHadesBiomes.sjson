      "{#CombatTextHighlightFormat}{$TraitData.ModsNikkelMHadesBiomesOrpheusBossFightMusicBoon.Name}{#Prev}!"
    }
    {
      Id = "ModsNikkelMHadesBiomesOrpheusOrpheusSong1Boon"
      InheritFrom = "MusicMusicPlayerOrpheusSong1MusicPlayer"
      Description =
      "Après avoir subi des dégâts, infligez immédiatement {$Keywords.Root} à {#BoldFormat}TOUS {#Prev}les ennemis."
    }
    {
      Id = "ModsNikkelMHadesBiomesOrpheusOrpheusSong1BoonCooldownStatDisplay"
      InheritFrom = "BaseStatLine"
      DisplayName = "{!Icons.Bullet}{#PropertyFormat}Temps de recharge :"
      Description = "{#UpgradeFormat}{$TooltipData.ExtractData.Cooldown} s{#Prev}"
    }
    {
      Id = "ModsNikkelMHadesBiomesOrpheusOrpheusSong2Boon"
      InheritFrom = "MusicMusicPlayerOrpheusSong2MusicPlayer"
      Description =
      "Une fois cette nuit, lorsque vous tombez à {#PenaltyFormat}0{#Prev}{!Icons.Health} sans qu'il vous reste de {$Keywords.ExtraChanceMisc}, vous perdez à la place tous vos {$Keywords.ModsNikkelMHadesBiomesCoreBoonPlural} et restaurez {#UpgradeFormat}{$TooltipData.ExtractData.LastStandHeal}%{#Prev}{!Icons.Health} et {!Icons.Mana}. Ce Bienfait ne désactive pas {$Keywords.ModsNikkelMHadesBiomesLowHealthBonus}."
    }
    {
      Id = "ModsNikkelMHadesBiomesOrpheusCharonShopThemeBoon"
      InheritFrom = "MusicMusicPlayerCharonShopThemeMusicPlayer"
      Description =
      "Tous les articles vendus par {$Keywords.CharCharon} coûtent moins cher."
    }
    {
      Id = "ModsNikkelMHadesBiomesOrpheusCharonShopThemeBoonDiscountStatDisplay"
      InheritFrom = "BaseStatLine"
       DisplayName = "{!Icons.Bullet}{#PropertyFormat}Remise aléatoire :"
       Description = "{#UpgradeFormat}{$TooltipData.ExtractData.TooltipMinDiscount}-{$TooltipData.ExtractData.TooltipMaxDiscount}%{#Prev}"
    }
    {
      Id = "ModsNikkelMHadesBiomesOrpheusEurydiceSong1Boon"
      InheritFrom = "MusicMusicPlayerEurydiceSong1MusicPlayer"
      Description =
      "Vous gagnez {#UpgradeFormat}{$TooltipData.StatDisplay1}{#Prev}{!Icons.ReRollAlt} et pouvez altérer les {#BoldFormat}Récompenses de Lieu{#Prev}. Cela ne rompt pas {$Keywords.Random}."
    }
