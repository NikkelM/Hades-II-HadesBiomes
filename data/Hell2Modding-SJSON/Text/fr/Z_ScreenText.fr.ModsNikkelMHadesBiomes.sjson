    // #endregion
    // #region Install screens
    {
      Id = "ModsNikkelMHadesBiomes_InstallSuccess"
      DisplayName = "Installation réussie !"
      Description =
      "Bienvenue dans {#DialogLegendaryFormat}Zagreus' Journey{#Prev} !\n\n Interagissez avec le portail de Chaos au Terrain d'Entraînement pour revivre, à travers les yeux de Mélinoé, le voyage de Zagreus, parti {#DialogLegendaryFormat}s'échapper des Enfers{#Prev} !\n\n Le mod vous plaît ? Soutenez son développement sur {#DialogLegendaryFormat}ko-fi.com/nikkelm{#Prev}.\n\n En cas de problème, ouvrez une discussion sur {#ItalicFormat}github.com/NikkelM/Hades-II-HadesBiomes/discussions{#Prev}\n et joignez le log obtenu via {#DialogLegendaryFormat}Paramètres -> Copier le fichier de log {#Prev}de votre gestionnaire de mods."
    }
    {
      Id = "ModsNikkelMHadesBiomes_InstallFailure"
      DisplayName = "Échec de l'installation !"
      Description =
      "Bienvenue dans {#DialogLegendaryFormat}Zagreus' Journey{#Prev} !\n\n L'installation du mod a {#DialogLegendaryFormat}ÉCHOUÉ{#Prev}, ou votre installation existante est corrompue.\n Consultez la console ouverte avec le jeu, ou le log, pour savoir comment résoudre le problème.\n Une réinstallation peut aider : pour cela, réglez\n{#DialogLegendaryFormat}firstTimeSetup {#Prev}et {#DialogLegendaryFormat}uninstall {#Prev}sur {#DialogLegendaryFormat}true {#Prev}dans la config du mod via votre gestionnaire de mods.\n\n Si le problème persiste, ouvrez une discussion sur\n{#ItalicFormat}github.com/NikkelM/Hades-II-HadesBiomes/discussions{#Prev}\n et joignez le log obtenu via {#DialogLegendaryFormat}Paramètres -> Copier le fichier de log {#Prev}de votre gestionnaire de mods."
    }
    {
      Id = "ModsNikkelMHadesBiomes_InstallFailure_HadesNotFound"
      DisplayName = "Échec de l'installation !"
      Description =
      "Bienvenue dans {#DialogLegendaryFormat}Zagreus' Journey{#Prev} !\n\n L'installation du mod a {#DialogLegendaryFormat}ÉCHOUÉ{#Prev}, ou votre installation existante est corrompue, car le mod {#DialogLegendaryFormat}n'a pas trouvé votre installation d'Hades (le premier jeu){#Prev}.\n Corrigez le paramètre de configuration {#DialogLegendaryFormat}hadesGameFolder {#Prev}dans votre gestionnaire de mods.\n\n Si le problème persiste, ouvrez une discussion sur\n{#ItalicFormat}github.com/NikkelM/Hades-II-HadesBiomes/discussions{#Prev}\n et joignez le log obtenu via {#DialogLegendaryFormat}Paramètres -> Copier le fichier de log {#Prev}de votre gestionnaire de mods."
    }
    {
      Id = "ModsNikkelMHadesBiomes_InstallFailure_HadesModsInstalled"
      DisplayName = "Échec de l'installation !"
      Description =
      "Bienvenue dans {#DialogLegendaryFormat}Zagreus' Journey{#Prev} !\n\n L'installation du mod a {#DialogLegendaryFormat}ÉCHOUÉ{#Prev}, ou votre installation existante est corrompue, car il a détecté que {#DialogLegendaryFormat}vous avez des mods d'Hades (le premier jeu) installés{#Prev}.\n Vous devez tous les désinstaller : supprimez ou renommez le dossier {#DialogLegendaryFormat}Mods {#Prev}de votre installation d'Hades, puis lancez {#DialogLegendaryFormat}modimporter.exe{#Prev}. Si cela ne fonctionne pas, vérifiez l'intégrité des fichiers d'Hades et d'Hades II.\n\n Si le problème persiste, ouvrez une discussion sur\n{#ItalicFormat}github.com/NikkelM/Hades-II-HadesBiomes/discussions{#Prev}\n et joignez le log obtenu via {#DialogLegendaryFormat}Paramètres -> Copier le fichier de log {#Prev}de votre gestionnaire de mods."
    }
    {
      Id = "ModsNikkelMHadesBiomes_InstallFailure_IncompatibleModsInstalled"
      DisplayName = "Mods Incompatibles Détectés !"
      Description =
      "Bienvenue dans {#DialogLegendaryFormat}Zagreus' Journey{#Prev} !\n\n L'installation a réussi, mais le mod a détecté des {#DialogLegendaryFormat}mods incompatibles installés{#Prev} que vous devez désinstaller. Rendez-vous sur\n{#ItalicFormat}github.com/NikkelM/Hades-II-HadesBiomes/wiki/Incompatible-Mods{#Prev}\n et désinstallez-les tous.\n Conserver des mods incompatibles peut provoquer toutes sortes de problèmes de jeu et n'est pas recommandé.\n Si vous n'avez aucun des mods listés, ignorez ce message.\n\n Si des problèmes persistent après résolution des incompatibilités, ouvrez une discussion sur\n{#ItalicFormat}github.com/NikkelM/Hades-II-HadesBiomes/discussions{#Prev}\n et joignez le log obtenu via {#DialogLegendaryFormat}Paramètres -> Copier le fichier de log {#Prev}de votre gestionnaire de mods."
    }
    {
      Id = "ModsNikkelMHadesBiomes_InstallFailure_MissingFiles"
      DisplayName = "Échec de l'installation !"
      Description =
      "Bienvenue dans {#DialogLegendaryFormat}Zagreus' Journey{#Prev} !\n\n L'installation du mod a {#DialogLegendaryFormat}ÉCHOUÉ{#Prev}, ou votre installation existante est corrompue, car le mod {#DialogLegendaryFormat}n'a pas pu copier tous ses fichiers{#Prev}.\n Vérifiez que le {#DialogLegendaryFormat}dossier de profil {#Prev}de votre gestionnaire de mods n'est pas en {#DialogLegendaryFormat}lecture seule{#Prev}, puis réinstallez le mod. Des fichiers peuvent aussi manquer à Hades : vérifiez le paramètre {#DialogLegendaryFormat}hadesGameFolder {#Prev}et l'intégrité de vos fichiers.\n\n Si le problème persiste, ouvrez une discussion sur\n{#ItalicFormat}github.com/NikkelM/Hades-II-HadesBiomes/discussions{#Prev}\n et joignez le log obtenu via {#DialogLegendaryFormat}Paramètres -> Copier le fichier de log {#Prev}de votre gestionnaire de mods."
    }
    {
      Id = "ModsNikkelMHadesBiomes_InstallFailure_HadesNotUpdated"
      DisplayName = "Échec de l'installation !"
      Description =
      "Bienvenue dans {#DialogLegendaryFormat}Zagreus' Journey{#Prev} !\n\n L'installation du mod a {#DialogLegendaryFormat}ÉCHOUÉ{#Prev}, ou votre installation existante est corrompue, car votre installation d'{#DialogLegendaryFormat}HADES {#Prev} n'est pas à jour et des données requises manquent. Mettez à jour Hades (pas Hades II !) via votre launcher, ou vérifiez l'intégrité des fichiers.\n Si vous avez une copie piratée d'Hades, le mod ne fonctionnera pas.\n\n Si le problème persiste, ouvrez une discussion sur\n{#ItalicFormat}github.com/NikkelM/Hades-II-HadesBiomes/discussions{#Prev}\n et joignez le log obtenu via {#DialogLegendaryFormat}Paramètres -> Copier le fichier de log {#Prev}de votre gestionnaire de mods."
    }
    {
      Id = "ModsNikkelMHadesBiomes_UninstallFailure"
      DisplayName = "Échec de la désinstallation !"
      Description =
      "La désinstallation de {#DialogLegendaryFormat}Zagreus' Journey {#Prev}a {#DialogLegendaryFormat}ÉCHOUÉ {#Prev}!\n\n Consultez les logs de la console pour en connaître la raison probable.\n\n Si le problème persiste, ouvrez une discussion sur\n{#ItalicFormat}github.com/NikkelM/Hades-II-HadesBiomes/discussions{#Prev}\n et joignez le log obtenu via {#DialogLegendaryFormat}Paramètres -> Copier le fichier de log {#Prev}de votre gestionnaire de mods."
    }
    // // If we failed to execute all sjson hooks
    {
      Id = "ModsNikkelMHadesBiomes_SjsonHookFailure"
      DisplayName = "Redémarrage Nécessaire !"
      Description =
      "Le jeu {#DialogLegendaryFormat}n'a pas pu charger {#Prev}certains fichiers requis par {#DialogLegendaryFormat}Zagreus' Journey{#Prev} !\n\n Le jeu peut alors planter, les ennemis n'infliger aucun dégât ou des ressources ne pas se charger.\n\n Pour résoudre le problème, {#DialogLegendaryFormat}redémarrer le jeu devrait suffire{#Prev} ! Sinon, réinstallez le mod en réglant {#DialogLegendaryFormat}firstTimeSetup {#Prev}et {#DialogLegendaryFormat}uninstall {#Prev} sur {#DialogLegendaryFormat}true {#Prev}dans la config du mod.\n\n Si le problème persiste, ouvrez une discussion sur\n{#ItalicFormat}github.com/NikkelM/Hades-II-HadesBiomes/discussions{#Prev}\n et joignez le log obtenu via {#DialogLegendaryFormat}Paramètres -> Copier le fichier de log {#Prev}de votre gestionnaire de mods."
    }
    // #endregion
